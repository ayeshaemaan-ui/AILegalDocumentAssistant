# ============================================================== LegalLens
# Copy to `.env` and fill in. Every value here has a working default except
# ANTHROPIC_API_KEY — retrieval and evaluation run without it, but generating
# answers does not.

# ---- LLM provider -------------------------------------------------------
# anthropic | openai | google | ollama
#
#   google  -> free tier, no credit card: https://aistudio.google.com/apikey
#   ollama  -> fully local and free:      ollama pull qwen2.5:7b-instruct
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# OpenAI model roles, used when LLM_PROVIDER=openai. Kept separate from the
# Claude names so switching providers does not mean rewriting model ids.
OPENAI_ANSWER_MODEL=gpt-5
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_JUDGE_MODEL=gpt-5-mini

# Gemini roles, used when LLM_PROVIDER=google.
GEMINI_ANSWER_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite

# Ollama roles, used when LLM_PROVIDER=ollama.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_ANSWER_MODEL=qwen2.5:7b-instruct
OLLAMA_FAST_MODEL=qwen2.5:7b-instruct

# Opus 5 answers (legal text rewards the stronger model); Haiku 4.5 handles the
# cheap high-volume roles — routing, query rewriting, grading, judging.
ANSWER_MODEL=claude-opus-5
FAST_MODEL=claude-haiku-4-5
JUDGE_MODEL=claude-haiku-4-5
ANSWER_EFFORT=medium
ANSWER_MAX_TOKENS=4096
ENABLE_PROMPT_CACHE=true

# ---- Embeddings (local, free, offline) ----------------------------------
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32

# ---- Vector store -------------------------------------------------------
# chroma (default, embedded) | pgvector | pinecone | weaviate
VECTOR_BACKEND=chroma
COLLECTION_NAME=legallens_clauses
# PG_CONNECTION=postgresql+psycopg://legallens:legallens@localhost:5432/legallens
# PINECONE_API_KEY=
# WEAVIATE_URL=http://localhost:8080

# ---- Chunking -----------------------------------------------------------
# recursive | legal_structural | semantic
CHUNK_STRATEGY=legal_structural
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# ---- Retrieval ----------------------------------------------------------
RETRIEVAL_TOP_K=20
FINAL_TOP_K=6
HYBRID_ENABLED=true
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4
RRF_K=60
RERANK_ENABLED=true
RERANK_BACKEND=cross_encoder
# Measured as harmful on CUAD (see scripts/ablate.py); off by default.
MMR_ENABLED=false
MMR_LAMBDA=0.7

# ---- Limits -------------------------------------------------------------
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BURST=10
DAILY_COST_CEILING_USD=25.0

# ---- Observability (all optional) ---------------------------------------
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=legallens
# HELICONE_API_KEY=
OTEL_ENABLED=true
# OTEL_ENDPOINT=http://localhost:4318/v1/traces

# ---- Dataset ------------------------------------------------------------
CUAD_DIR=/Users/mac/Desktop/CUAD_v1

# ---- App ----------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO
